set icons false
set drawbox false
set ratios 1:2
set info size
set timefmt "2006-01-02 15:04"

set previewer ~/.config/lf/preview
set cleaner true

map h updir
map l open
map g top
map G bottom
map H high
map M middle
map L low
map J half-down
map K half-up

map gh cd ~
map gc cd ~/.config
map gd cd ~/dotfiles

map <delete> delete
map x cut
map y copy
map p paste
map r rename
map a push %mkdir<space>

map e $$EDITOR "$f"

map q quit
