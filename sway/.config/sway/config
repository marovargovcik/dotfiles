set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
# Launcher lists only the .desktop files in ~/.config/fuzzel/applications.
set $menu env XDG_DATA_HOME=$HOME/.config/fuzzel XDG_DATA_DIRS=$HOME/.config/fuzzel fuzzel

output * bg ~/.local/share/backgrounds/wallhaven-mlyx18_2560x1440.png fill
set $laptop eDP-1
output $laptop scale 1 position 0 360
# Acer XV272U, matched by identifier so any port works. Sway takes the fastest
# 1440p mode offered: 60Hz via USB-C->HDMI adapter, 144Hz via USB-C->DP cable.
output "Acer Technologies XV272U 0x10508FFC" mode 2560x1440@144Hz position 1920 0
# Laptop sits left of the Acer with bottom edges level: 360 = 1440 - 1080.

# A plugged-in monitor becomes the main screen with workspaces 1-4 and the
# laptop keeps only workspace 5. Without one, all five are on the laptop.
# Closing the lid disables the panel, so 5 joins the rest on the external
# and returns to the laptop when the lid opens.
set $externals DP-1 DP-2 DP-3 DP-4 HDMI-A-1
workspace 1 output $externals $laptop
workspace 2 output $externals $laptop
workspace 3 output $externals $laptop
workspace 4 output $externals $laptop
workspace 5 output $laptop $externals

# Lid closed without an external monitor still suspends (elogind).
bindswitch --reload --locked lid:on output $laptop disable
bindswitch --reload --locked lid:off output $laptop enable
# bindswitch only fires on change; cover starting sway with the lid shut.
exec grep -q closed /proc/acpi/button/lid/LID/state && swaymsg output $laptop disable

input type:keyboard {
    xkb_layout "us,sk"
    xkb_variant ",qwerty"
}

input type:touchpad {
    natural_scroll enabled
    # Press anywhere = left, two-finger press/tap = right, three = middle.
    click_method clickfinger
    tap enabled
    pointer_accel 0.4
}

bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
bindsym --release Mod1+Shift_L exec swaymsg input type:keyboard xkb_switch_layout next
floating_modifier $mod normal

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym Print exec grim
bindsym $mod+c exec clipman pick --tool=CUSTOM --tool-args="fuzzel -d"

exec pipewire
# Secret service for 1Password; also needs the PAM lines (README §8) and dbus-run-session.
exec gnome-keyring-daemon --start --daemonize --components=secrets
exec wl-paste -t text --watch clipman store
exec /usr/libexec/xfce-polkit

# Lock at 300s and report the session idle to elogind; elogind owns suspend.
# Without `idlehint` a wayland session never reports idle and IdleAction never fires.
exec swayidle -w \
    timeout 300 swaylock \
    idlehint 300 \
    before-sleep swaylock \
    after-resume 'swaymsg "output * power on"'

bar {
    position top
    font pango:Hack Nerd Font 11
    status_command start-statusbar

    colors {
        statusline #ffffff
        background #323232
        inactive_workspace #32323200 #32323200 #5c5c5c
    }
}

include /etc/sway/config.d/*
