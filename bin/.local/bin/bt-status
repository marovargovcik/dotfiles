#!/bin/bash
# Bar block for Bluetooth, run with persistent = true: prints the state once,
# then sleeps on the system bus and reprints whenever BlueZ reports a device's
# Connected or Alias property changing. Nothing runs between events. Should
# gdbus exit (bluetoothd restarted, bus gone) the script exits with it and
# i3status-rs starts it again a few seconds later.
#
# State comes from BlueZ's D-Bus objects (busctl, parsed as JSON), not from
# bluetoothctl's human-oriented output. One device is shown, "(+N)" for more:
#   󰂯                        nothing connected
#   󰂱 QCY MeloBuds N20        one device
#   󰂱 QCY MeloBuds N20 (+1)   two devices
# A device without a Name (typically an LE peer) is labelled by its MAC;
# named devices are preferred for the label.
#
# Properties are read per device rather than with one GetManagedObjects call:
# elogind 252's busctl can't encode dicts with integer keys as JSON (e.g. the
# a{qv} ManufacturerData some headsets expose) and fails the whole call with
# exit 1 and no output, which made every device look disconnected.

read -r -d '' FORMAT <<'EOF'
[inputs | select(.[0].data == true)
        | if length > 3 then [0, .[1].data] else [1, .[2].data] end]
| sort
| if length == 0 then "󰂯"
  else "󰂱 \(.[0][1] | gsub("^\\s+|\\s+$"; ""))"
       + (if length > 1 then " (+\(length - 1))" else "" end)
  end
EOF

# One JSON array per device: [Connected, Alias, Address(, Name)]. get-property
# stops at the first missing property, so Name is asked for last and its
# presence is what marks a device as named.
status() {
    local path
    busctl --system --list tree org.bluez 2>/dev/null |
        grep -E '^/org/bluez/hci[0-9]+/dev_[0-9A-F_]+$' |
        while read -r path; do
            printf '[%s]\n' "$(busctl --system --json=short get-property \
                org.bluez "$path" org.bluez.Device1 \
                Connected Alias Address Name 2>/dev/null | paste -sd,)"
        done | jq -rn "$FORMAT"
}

status
gdbus monitor --system --dest org.bluez 2>/dev/null | while read -r line; do
    case $line in *"'Connected': <"* | *"'Alias': <"*) status ;; esac
done
