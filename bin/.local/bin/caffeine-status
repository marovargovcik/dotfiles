#!/bin/bash
# Bar block for caffeine (see caffeine-menu and caffeine-agents): a full cup
# while the timer holds off sleep, with the minutes left when there is a limit,
# a robot while agents do, both when both do; an empty cup otherwise.

src=$(realpath "${BASH_SOURCE[0]}")
lib=${src%/*}/../lib/caffeine
# shellcheck source=../lib/caffeine/common.sh
source "$lib/common.sh"

# timer_text: the full cup, with the minutes left when there is a limit; nothing
# once the time is up.
timer_text() {
    local pid until
    read -r pid until < <(timer) || return 0
    [ "$until" -eq 0 ] || [ "$until" -gt "$EPOCHSECONDS" ] || return 0
    if [ "$until" -eq 0 ]; then
        printf '\U000F0176\n'
    else
        printf '\U000F0176 %dm\n' $(((until - EPOCHSECONDS + 59) / 60))
    fi
}

text=$(timer_text)
agents_awake && text=$'\U000F06A9'"${text:+ $text}"

if [ -n "$text" ]; then
    printf '{"text":"%s","state":"Good"}\n' "$text"
else
    printf '{"text":"\U000F06CA"}\n'
fi
