#!/bin/bash
# fuzzel menu for caffeine: hold off sleep for a while, or until turned off.
# An elogind sleep inhibitor blocks the idle suspend; the screen still locks.
# Closing the lid still suspends, and so do power-menu and batsignal: logind
# lets the inhibitor's own user through.
#
# $XDG_RUNTIME_DIR/caffeine holds the inhibitor's pid and when it ends
# (0 = never); caffeine-status reads it.

state="$XDG_RUNTIME_DIR/caffeine"

choice=$(printf '%s\n' off indefinitely '5 min' '10 min' '15 min' '30 min' '60 min' |
         fuzzel -d --no-exit-on-keyboard-focus-loss)
case "$choice" in
    '')           exit 0 ;;
    off)          secs= ;;
    indefinitely) secs=infinity ;;
    *)            secs=$(( ${choice% min} * 60 )) ;;
esac

# A new choice replaces the running one. The cmdline check skips a pid that
# has since been reused by something else.
read -r pid _ 2>/dev/null <"$state" && grep -qs caffeine "/proc/$pid/cmdline" &&
    kill -- "-$pid" 2>/dev/null
rm -f "$state"

if [ -n "$secs" ]; then
    until=0
    [ "$secs" = infinity ] || until=$(( EPOCHSECONDS + secs ))
    # setsid gives it its own process group, so off kills the wait along with
    # the inhibitor. The wait checks the wall clock at least once a minute
    # because sleep stops counting while suspended. When the time runs out it
    # refreshes the bar itself.
    setsid sh -c 'elogind-inhibit --what=sleep --who=caffeine --why=caffeine sh -c '\''
                      [ "$1" -eq 0 ] && exec sleep infinity
                      while left=$(( $1 - $(date +%s) )); [ "$left" -gt 0 ]; do
                          sleep $(( left < 60 ? left : 60 ))
                      done'\'' sh "$1"
                  pkill -RTMIN+9 -x i3status-rs' sh "$until" </dev/null >/dev/null 2>&1 &
    echo "$! $until" >"$state"
fi

pkill -RTMIN+9 -x i3status-rs
