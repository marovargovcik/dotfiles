#!/bin/bash
# fuzzel menu for caffeine: hold off sleep for a while, or until turned off.
# An elogind sleep inhibitor blocks the idle suspend; the screen still locks.
# Closing the lid still suspends, and so do power-menu and batsignal: logind
# lets the inhibitor's own user through.
#
# $XDG_RUNTIME_DIR/caffeine holds the inhibitor's pid and when it ends
# (0 = never); caffeine-status reads it.
#
# While caffeine-agents holds its own inhibitor, a first line says so and
# explains the bar's robot; picking it changes nothing.

src=$(realpath "${BASH_SOURCE[0]}")
lib=${src%/*}/../lib/caffeine
# shellcheck source=../lib/caffeine/common.sh
source "$lib/common.sh"

agents=$'\U000F06A9 agents working: awake until they finish'

# choose: the line picked in fuzzel, or nothing.
choose() {
    {
        agents_awake && printf '%s\n' "$agents"
        printf '%s\n' off indefinitely '5 min' '10 min' '15 min' '30 min' '60 min'
    } | fuzzel -d --no-exit-on-keyboard-focus-loss
}

# stop: ends the running timer, if any.
stop() {
    local pid _
    read -r pid _ < <(timer) && kill -- "-$pid" 2>/dev/null
    rm -f "$state"
}

# start <seconds|infinity>: a timer holding off sleep for that long, recorded
# in $state. setsid gives it its own process group, so stop kills the wait
# along with the inhibitor. The wait checks the wall clock at least once a
# minute because sleep stops counting while suspended. When the time runs out
# it refreshes the bar itself.
start() {
    local until=0
    [ "$1" = infinity ] || until=$((EPOCHSECONDS + $1))
    # shellcheck disable=SC2016 # the inner shells expand them
    setsid sh -c 'elogind-inhibit --what=sleep --who=caffeine --why=caffeine sh -c '\''
                      [ "$1" -eq 0 ] && exec sleep infinity
                      while left=$(( $1 - $(date +%s) )); [ "$left" -gt 0 ]; do
                          sleep $(( left < 60 ? left : 60 ))
                      done'\'' sh "$1"
                  pkill -RTMIN+9 -x i3status-rs' sh "$until" </dev/null >/dev/null 2>&1 &
    echo "$! $until" >"$state"
}

choice=$(choose)
case "$choice" in
'' | "$agents") exit 0 ;;
off) secs= ;;
indefinitely) secs=infinity ;;
*) secs=$((${choice% min} * 60)) ;;
esac

# A new choice replaces the running one.
stop
[ -z "$secs" ] || start "$secs"
refresh_bar
