#!/bin/bash
# Bar block for USB storage. Lists every USB filesystem by label, and goes Good
# (green) once at least one of them is mounted. With nothing attached it emits
# empty text and hide_when_empty drops the block — see the note further down.
#
# Plug/unplug refreshes it within a frame via /etc/udev/rules.d/99-usb-bar.rules,
# which signals i3status-rs; the block's interval is only a safety net.
#
# lsblk -J hands over the device tree and jq writes the block's JSON, so labels
# on a stranger's USB stick are escaped by jq, never pasted in by hand. lsblk
# fills TRAN on the disk but leaves it empty on its partitions for USB (unlike
# nvme, where it propagates), so devs() carries the transport down the tree.
#
# Always valid JSON, empty text when there is nothing to show: hide_when_empty
# then drops the block. Printing *nothing* here does not hide it — the block
# flips to "Invalid JSON" a few seconds in, once the empty parse surfaces. Hence
# the fallback to no devices when lsblk prints nothing.

lsblk -J -o NAME,TYPE,TRAN,FSTYPE,LABEL,MOUNTPOINT | jq -nc '
    def devs(t): (.tran // t) as $t | (.tran = $t), (.children[]? | devs($t));
    [[inputs][0].blockdevices // [] | .[] | devs(null)
     | select(.tran == "usb")                # add "mmc" here to cover the SD slot
     | select(.type == "part" or .type == "disk")
     | select(.fstype | IN(null, "swap", "linux_raid_member", "LVM2_member", "crypto_LUKS") | not)]
    | if length == 0 then {text: ""}
      else {text: (" " + (map(.label // .name) | join(", "))),
            state: (if any(.mountpoint) then "Good" else "Idle" end)}
      end'
