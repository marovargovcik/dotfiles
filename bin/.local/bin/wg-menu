#!/bin/bash
# fuzzel menu for WireGuard: picks a tunnel of ~/.config/wireguard and brings
# it up, or down when it's connected.

dir=$HOME/.config/wireguard
active=$(sudo wg show interfaces 2>/dev/null | tr ' ' '\n')

# connected <tunnel>: whether the tunnel is up.
connected() { echo "$active" | grep -qx "$1"; }

# entries: a line per tunnel, "[connected]" before each one that's up.
entries() {
    local conf name
    for conf in "$dir/"*.conf; do
        [ -f "$conf" ] || continue
        name=$(basename "$conf" .conf)
        if connected "$name"; then
            echo "[connected] $name"
        else
            echo "$name"
        fi
    done
}

items=$(entries)
[ -n "$items" ] || exit 0

selected=$(fuzzel -d --no-exit-on-keyboard-focus-loss <<<"$items")
[ -z "$selected" ] && exit 0
tunnel=${selected#\[connected\] }

if connected "$tunnel"; then
    sudo wg-quick down "$dir/$tunnel.conf"
else
    sudo wg-quick up "$dir/$tunnel.conf"
fi
