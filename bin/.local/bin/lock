#!/bin/sh
# Lock the screen; unlock with the password or a touch of the fingerprint reader.
pgrep -x swaylock >/dev/null && exit 0
swaylock -f "$@" || exit

# The locked screen cannot show a rejected finger, so blink the keyboard backlight.
flash() {
    led=tpacpi::kbd_backlight
    was=$(brightnessctl -d "$led" get)
    [ "$was" -eq 0 ] && blink=100% || blink=0
    brightnessctl -q -d "$led" set "$blink"
    sleep 0.3
    brightnessctl -q -d "$led" set "$was"
}

# swaylock has no fingerprint support but unlocks on SIGUSR1. Follow this swaylock by
# PID so that a loop left over from an earlier lock cannot latch onto the next one.
pid=$(pgrep -n -x swaylock) || exit
(
    while kill -0 "$pid" 2>/dev/null; do
        # A verify whose daemon died never returns; the timeout keeps the loop alive.
        case $(timeout 60 fprintd-verify 2>/dev/null) in
            *verify-match*)    kill -USR1 "$pid" ;;
            *verify-no-match*) flash ;;
        esac
        sleep 1
    done
) &
loop=$!

# Release the reader when the password was typed instead.
(
    while kill -0 "$pid" 2>/dev/null; do sleep 1; done
    # Wait out a verify the loop above may have just started.
    sleep 1
    # The command substitution execs timeout, which passes the signal on to the verify.
    pkill -P "$loop" -x timeout
) &
