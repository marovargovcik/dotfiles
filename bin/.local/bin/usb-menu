#!/bin/bash
# fuzzel menu for USB storage. Every entry is verb-first, so what a selection
# does is never a guess: mount / open / unlock / eject.
#
# udisks2 does the actual work over D-Bus: mounts land in /run/media/$USER/<label>
# with sane per-filesystem options, and polkit lets an active seat0 session mount
# and power off *removable* media with no password (§13 has no fragment for this).

term=foot

fail() { swaynag -t error -m "usb-menu: $1"; exit 1; }

# jq walks lsblk's device tree, carrying the transport and the owning disk down
# from the top (see usb-status for why TRAN needs carrying), and prints each
# menu entry as three NUL-terminated strings: action, target, menu line. No
# label or mountpoint can contain a NUL, so they arrive byte for byte.
read -r -d '' MENU <<'EOF'
def devs(t; d): (.tran // t) as $t | (d // .name) as $d
    | (.tran = $t | .disk = $d), (.children[]? | devs($t; $d));
[[inputs][0].blockdevices // [] | .[] | devs(null; null)
 | select(.tran == "usb")]                   # add "mmc" here to cover the SD slot
| map(select(.fstype | IN(null, "swap", "linux_raid_member", "LVM2_member") | not)) as $fs
| ($fs[]
   | (.label // .name) as $name
   | if .fstype == "crypto_LUKS" then
         "unlock", "/dev/\(.name)", "unlock  \($name)   \(.size)   encrypted"
     elif .mountpoint then
         "open", .mountpoint, "open    \($name)   \(.mountpoint)"
     else
         "mount", "/dev/\(.name)", "mount   \($name)   \(.size)   \(.fstype)"
     end),
  # Eject entries come last, one per drive, named after the labels on it: you
  # recognise a stick by the label on it, not by the controller its vendor
  # soldered on. Only a real label, never the kernel name: with nothing to
  # recognise the stick by, the entry is better off naming the hardware.
  (.[] | select(.type == "disk")
   | .name as $n
   | ([$fs[] | select(.disk == $n) | .label // empty] | join(", ")) as $labels
   | ([.vendor, .model | values | gsub("_"; " ") | splits(" +")]
      | map(select(. != "")) | join(" ") | if . == "" then $n end) as $model
   | "eject", "/dev/\($n)",
     if $labels != "" then "eject   \($labels)   \(.size)   \($model)"
     else "eject   \($model)   \(.size)" end)
EOF

items=(); acts=(); targets=()
while IFS= read -r -d '' act && IFS= read -r -d '' target && IFS= read -r -d '' item; do
    acts+=("$act"); targets+=("$target"); items+=("$item")
done < <(lsblk -J -o NAME,TYPE,TRAN,FSTYPE,LABEL,SIZE,MOUNTPOINT,VENDOR,MODEL |
         jq -n --raw-output0 "$MENU")

[ ${#items[@]} -eq 0 ] && exit 0

i=$(printf '%s\n' "${items[@]}" | fuzzel -d --index --no-exit-on-keyboard-focus-loss)
[ -z "$i" ] && exit 0
target=${targets[$i]}

case "${acts[$i]}" in
    mount)
        out=$(udisksctl mount --no-user-interaction -b "$target" 2>&1) || fail "$out" ;;
    open)
        exec $term --working-directory="$target" ;;
    unlock)
        # udisksctl reads the passphrase from a tty, so it needs a terminal;
        # the cleartext device shows up as a fresh "mount" entry afterwards.
        $term udisksctl unlock -b "$target"
        exec "$0" ;;
    eject)
        while read -r part _; do
            out=$(udisksctl unmount --no-user-interaction -b "$part" 2>&1) || fail "$out"
        done < <(lsblk -nlo PATH,MOUNTPOINT "$target" | awk 'NF > 1')
        out=$(udisksctl power-off --no-user-interaction -b "$target" 2>&1) || fail "$out" ;;
esac

pkill -RTMIN+8 -x i3status-rs
