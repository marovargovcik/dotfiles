#!/bin/bash
# fuzzel menu for USB storage. Every entry is verb-first, so what a selection
# does is never a guess: mount / open / unlock / eject.
#
# udisks2 does the actual work over D-Bus: mounts land in
# /run/media/$USER/<label> with sane per-filesystem options, and polkit lets an
# active seat0 session mount and power off *removable* media with no password
# (§13 has no fragment for this).

src=$(realpath "${BASH_SOURCE[0]}")
lib=${src%/*}/../lib/usb
term=foot

fail() {
    swaynag -t error -m "usb-menu: $1"
    exit 1
}

# load_menu: the menu's entries, from ../lib/usb/menu.jq, into acts, targets
# and items. jq prints each string NUL-terminated: no label or mountpoint can
# contain a NUL, so they arrive byte for byte.
load_menu() {
    local act target item
    acts=() targets=() items=()
    while IFS= read -r -d '' act && IFS= read -r -d '' target && IFS= read -r -d '' item; do
        acts+=("$act")
        targets+=("$target")
        items+=("$item")
    done < <(lsblk -J -o NAME,TYPE,TRAN,FSTYPE,LABEL,SIZE,MOUNTPOINT,VENDOR,MODEL |
        jq -n --raw-output0 -L "$lib" -f "$lib/menu.jq")
}

# udisks <command> <device>: runs udisksctl without asking for a password, or
# shows its error and stops.
udisks() {
    local out
    out=$(udisksctl "$1" --no-user-interaction -b "$2" 2>&1) || fail "$out"
}

# eject <disk>: unmounts what's mounted on it, then powers it off.
eject() {
    local part _
    while read -r part _; do
        udisks unmount "$part"
    done < <(lsblk -nlo PATH,MOUNTPOINT "$1" | awk 'NF > 1')
    udisks power-off "$1"
}

load_menu
[ ${#items[@]} -eq 0 ] && exit 0

i=$(printf '%s\n' "${items[@]}" | fuzzel -d --index --no-exit-on-keyboard-focus-loss)
[ -z "$i" ] && exit 0
target=${targets[$i]}

case "${acts[$i]}" in
mount)
    udisks mount "$target"
    ;;
open)
    exec $term --working-directory="$target"
    ;;
unlock)
    # udisksctl reads the passphrase from a tty, so it needs a terminal;
    # the cleartext device shows up as a fresh "mount" entry afterwards.
    $term udisksctl unlock -b "$target"
    exec "$0"
    ;;
eject)
    eject "$target"
    ;;
esac

pkill -RTMIN+8 -x i3status-rs
