[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true

[diff]
    colorMoved = default

[merge]
    conflictstyle = diff3
[init]
	defaultBranch = main
[user]
	email = vargovcik.marek@gmail.com
	name = Marek Vargovčík
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
